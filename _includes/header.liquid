<header>
  {% assign current_lang = page.lang | default: site.lang %}
  {% assign home_page = site.pages | where: "lang_ref", "about" | where: "lang", current_lang | first %}
  {% assign all_docs = site.pages | concat: site.projects | concat: site.news %}
  {% assign english_home = site.pages | where: "lang_ref", "about" | where: "lang", "en" | first %}
  {% assign chinese_home = site.pages | where: "lang_ref", "about" | where: "lang", "zh" | first %}
  {% assign english_page = english_home %}
  {% assign chinese_page = chinese_home %}

  {% if page.lang_ref %}
    {% assign paired_english_page = all_docs | where: "lang_ref", page.lang_ref | where: "lang", "en" | first %}
    {% assign paired_chinese_page = all_docs | where: "lang_ref", page.lang_ref | where: "lang", "zh" | first %}
    {% if paired_english_page %}
      {% assign english_page = paired_english_page %}
    {% endif %}
    {% if paired_chinese_page %}
      {% assign chinese_page = paired_chinese_page %}
    {% endif %}
  {% endif %}

  {% assign brand_name = home_page.display_name %}
  {% if brand_name == nil or brand_name == '' %}
    {% capture brand_name -%}
      {{ site.first_name -}}
      {%- if site.middle_name %} {{ site.middle_name }}{% endif -%}
      {%- if site.last_name %} {{ site.last_name }}{% endif -%}
    {%- endcapture %}
  {% endif %}

  <!-- Nav Bar -->
  <nav id="navbar" class="navbar navbar-light navbar-expand-sm {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation">
    <div class="container">
      {% if home_page and page.url != home_page.url %}
        <a class="navbar-brand title font-weight-lighter" href="{{ home_page.url | relative_url }}">
          {{- brand_name -}}
        </a>
      {% elsif site.enable_navbar_social %}
        <!-- Social Icons -->
        <div class="navbar-brand social">{% social_links %}</div>
      {% endif %}
      <!-- Navbar Toggle -->
      <button
        class="navbar-toggler collapsed ml-auto"
        type="button"
        data-toggle="collapse"
        data-target="#navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="collapse navbar-collapse text-right" id="navbarNav">
        <ul class="navbar-nav ml-auto flex-nowrap">
          {% if home_page %}
            {% for item in home_page.nav_sections %}
              <li class="nav-item">
                <a class="nav-link" href="{{ home_page.url | relative_url }}#{{ item.anchor }}">
                  {{- item.label -}}
                </a>
              </li>
            {% endfor %}
          {% endif %}

          <li class="nav-item language-switcher">
            <span class="nav-link">
              {% if current_lang == 'en' %}
                <span class="lang-current">EN</span>
              {% else %}
                <a href="{{ english_page.url | relative_url }}">EN</a>
              {% endif %}
              <span class="lang-separator">/</span>
              {% if current_lang == 'zh' %}
                <span class="lang-current">简</span>
              {% else %}
                <a href="{{ chinese_page.url | relative_url }}">简</a>
              {% endif %}
            </span>
          </li>

          {% if site.search_enabled %}
            <!-- Search -->
            <li class="nav-item">
              <button id="search-toggle" title="Search" onclick="openSearchModal()">
                <span class="nav-link">ctrl k <i class="fa-solid fa-magnifying-glass"></i></span>
              </button>
            </li>
          {% endif %}
          {% if site.enable_darkmode %}
            <!-- Toogle theme mode -->
            <li class="toggle-container">
              <button id="light-toggle" title="Change theme">
                <i class="fa-half-sun-moon" id="light-toggle-system"></i>
                <i class="fa-solid fa-moon" id="light-toggle-dark"></i>
                <i class="fa-solid fa-sun" id="light-toggle-light"></i>
              </button>
            </li>
          {% endif %}
        </ul>
      </div>
    </div>
  </nav>
  {% if site.enable_progressbar %}
    <!-- Scrolling Progress Bar -->
    <progress id="progress" value="0">
      <div class="progress-container">
        <span class="progress-bar"></span>
      </div>
    </progress>
  {% endif %}
</header>
