{% assign current_lang = page.lang | default: site.lang %}
{% capture footer_contents -%}
  {%- if current_lang == 'zh' -%}
    &copy; {{ site.time | date: '%Y' }} 麻奕鑫。最后更新于 {{ site.time | date: '%Y 年 %-m 月' }}。
  {%- else -%}
    &copy; {{ site.time | date: '%Y' }} Yixin Ma. Last updated {{ site.time | date: '%B %Y' }}.
  {%- endif -%}
{%- endcapture %}

{% if site.footer_fixed %}
  <footer class="fixed-bottom" role="contentinfo">
    <div class="container mt-0">
      {{ footer_contents }}
      <button
        type="button"
        class="footer-easter-egg"
        data-footer-easter-egg
        aria-label="Decorative footer element"
      >
        •
      </button>
    </div>
  </footer>
{% else %}
  <footer class="sticky-bottom mt-5" role="contentinfo">
    {% if site.newsletter.enabled %}
      {% include newsletter.liquid %}
    {% endif %}

    <div class="container">
      {{ footer_contents }}
      <button
        type="button"
        class="footer-easter-egg"
        data-footer-easter-egg
        aria-label="Decorative footer element"
      >
        •
      </button>
    </div>
  </footer>
{% endif %}
